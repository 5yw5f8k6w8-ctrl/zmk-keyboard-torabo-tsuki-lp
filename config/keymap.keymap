#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <43 41>;
            layers = <2>;
        };
    };

    macros {
        LIN: LIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp A &kp N &kp G &kp E &kp A>;
            label = "LIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans            &trans  &trans  &trans        &trans        &trans                                                &trans            &trans  &trans     &trans         &trans           &trans
&kp ESC           &kp Q   &kp W   &kp E         &kp R         &kp T                                                 &kp Y             &kp U   &kp I      &kp O          &kp P            &kp BSPC
&kp LEFT_SHIFT    &kp A   &kp S   &kp D         &kp F         &kp G        &trans              &trans               &kp H             &kp J   &kp K      &kp L          &kp SEMI         &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V         &kp B        &lt 2 LEFT_BRACKET  &lt 2 RIGHT_BRACKET  &kp N             &kp M   &kp COMMA  &kp DOT        &kp QUESTION     &kp EQUAL
&mo 3             &none   &none   &kp LEFT_ALT  &kp LEFT_WIN  &lt 1 LANG2  &kp SPACE           &kp RETURN           &lt 1 LANGUAGE_1  &trans  &trans     &kp RIGHT_ALT  &kp RIGHT_SHIFT  &none
            >;
        };

        layer_1 {
            bindings = <
&trans          &trans            &trans            &trans            &trans            &trans                                    &trans            &trans      &trans      &trans      &trans      &trans
&kp TAB         &kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp NUMBER_4      &kp N5                                    &kp NUMBER_6      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS
&kp LEFT_SHIFT  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)  &trans            &trans      &kp LS(NUMBER_6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &kp GRAVE
&kp LCTRL       &none             &none             &none             &none             &none       &kp LC(UP_ARROW)  &kp DELETE  &none             &none       &none       &trans      &none       &kp NON_US_BACKSLASH
&none           &none             &none             &none             &none             &none       &kp SPACE         &kp ENTER   &trans            &trans      &trans      &trans      &trans      &none
            >;
        };

        layer_2 {
            bindings = <
&trans            &trans          &trans            &trans  &trans  &trans                   &trans          &trans          &trans           &trans  &trans  &trans
&trans            &kp F1          &kp F2            &kp F3  &kp F4  &kp F5                   &none           &kp UP_ARROW    &none            &none   &none   &trans
&kp LEFT_SHIFT    &kp F6          &kp F7            &kp F8  &kp F9  &kp F10  &trans  &trans  &kp LEFT_ARROW  &none           &kp RIGHT_ARROW  &none   &none   &trans
&kp LEFT_CONTROL  &kp LC(LS(N4))  &kp LC(UP_ARROW)  &none   &none   &none    &trans  &trans  &none           &kp DOWN_ARROW  &none            &none   &none   &trans
&trans            &trans          &trans            &trans  &trans  &trans   &trans  &none   &none           &none           &trans           &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans                        &trans          &trans          &trans           &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none         &bt BT_SEL 4                  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &none   &none   &trans
&bt BT_CLR    &none         &none         &none         &none         &none         &trans  &trans  &mmv MOVE_LEFT  &mkp MCLK       &mmv MOVE_RIGHT  &none   &none   &trans
&none         &none         &out OUT_TOG  &out OUT_USB  &out OUT_BLE  &none         &trans  &trans  &mkp LCLK       &mmv MOVE_DOWN  &mkp RCLK        &none   &none   &trans
&none         &none         &none         &trans        &LIN          &none         &trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans           &trans              &trans              &trans           &trans  &trans                  &trans           &trans              &trans              &trans  &trans  &trans
&trans           &trans              &trans              &trans           &trans  &trans                  &trans           &msc MOVE_Y(15)     &trans              &trans  &trans  &trans
&trans           &trans              &trans              &trans           &trans  &trans  &trans  &trans  &msc MOVE_X(15)  &msc (MOVE_Y(-15))  &msc (MOVE_X(-15))  &trans  &trans  &trans
&trans           &trans              &trans              &trans           &trans  &trans  &trans  &trans  &mkp LCLK        &mkp MCLK           &mkp RCLK           &trans  &trans  &trans
&msc MOVE_X(15)  &msc (MOVE_X(-15))  &msc (MOVE_Y(-15))  &msc MOVE_Y(15)  &trans  &trans  &trans  &trans  &trans           &trans              &trans              &trans  &trans  &trans
            >;
        };
    };
};
